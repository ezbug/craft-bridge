# Optional advanced overrides. The app normally stores non-secret settings in:
# ~/Library/Application Support/craft-obsidian-bridge/config.json
# OBSIDIAN_VAULT=/absolute/path/to/your/Obsidian/Vault
# OBSIDIAN_VAULT_NAME=My Vault
# OBSIDIAN_BRIDGE_STATE_DIR=/custom/path/to/craft-obsidian-bridge
# OBSIDIAN_BRIDGE_CONFIG=/custom/path/to/config.json
OBSIDIAN_BRIDGE_BACKUP_RETENTION_DAYS=30
OBSIDIAN_BRIDGE_MAX_READ_CHARS=20000
CRAFT_SPACE_API_URL=
CRAFT_BRIDGE_PORT=47832
# Set to 1 in isolated tests to avoid reading Craft API credentials from the user's Keychain.
CRAFT_BRIDGE_DISABLE_CRAFT_API=0
# OBSIDIAN_BRIDGE_LAUNCH_AT_LOGIN=false
