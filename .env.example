# Optional overrides for local development only.
# The app normally saves non-secret settings in:
# ~/Library/Application Support/craft-obsidian-bridge/config.json
# This file is a shell example; the project does not automatically load dotenv files.

export OBSIDIAN_VAULT="/absolute/path/to/your/Obsidian Vault"
export OBSIDIAN_VAULT_NAME="Your Vault"
export CRAFT_BRIDGE_PORT="47832"
export OBSIDIAN_BRIDGE_BACKUP_RETENTION_DAYS="30"
export OBSIDIAN_BRIDGE_MAX_READ_CHARS="20000"

# For isolated developer setups, you may override the non-secret state paths:
# export OBSIDIAN_BRIDGE_STATE_DIR="/absolute/path/to/local/craft-bridge-state"
# export OBSIDIAN_BRIDGE_CONFIG="/absolute/path/to/config.json"
# export OBSIDIAN_BRIDGE_BACKUPS="/absolute/path/to/local/craft-bridge-state/backups"

# Do not put a real Craft API Connection URL in this file.
# Configure it in the macOS app so it is stored in Keychain. CRAFT_SPACE_API_URL
# exists only as an explicit development override and should never be committed.
